  e1@{ shape: icon, icon: "bpmn:end", label: "Refused", pos: "b", h: 40 }
  t3("fa:fa-user Issue invoice")
end
subgraph L2["Warehouse"]
  t4("fa:fa-gear Collect order")
  db1[("Warehouse DB")]
  d1@{ shape: doc, label: "Waybill" }
  e2@{ shape: icon, icon: "bpmn:end", label: "Order shipped", pos: "b", h: 40 }
end
subgraph L3["Customer"]
  t5("fa:fa-user Pay invoice")
end
s1 --> t1 --> g1
g1 -->|No| t2 --> e1
g1 -->|Yes| t3 --> t4 --> e2
